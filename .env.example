# Google Gemini API Key (obtener gratis en https://aistudio.google.com/)
GEMINI_API_KEY=tu_gemini_api_key_aqui

# Telegram Bot (crear con @BotFather en Telegram)
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ
# Tu ID de chat en Telegram (obtener enviando un mensaje a @userinfobot en Telegram)
TELEGRAM_CHAT_ID=123456789

# GitHub Username y Token
GH_USERNAME=tu_usuario_de_github
# GH_TOKEN es opcional si solo leés repos públicos, o requerido (PAT) para repos privados u organizaciones
GH_TOKEN=ghp_tu_personal_access_token_aqui

# Configuración opcional
# LOOKBACK_DAYS: Cuántos días hacia atrás buscar commits (por defecto 1 para revisión diaria)
LOOKBACK_DAYS=1
# GEMINI_MODEL: Modelo a usar (por defecto gemini-3.7-flash)
GEMINI_MODEL=gemini-3.7-flash
