# ==========================================================
# SELECCIÓN DE PROVEEDOR DE LLM (Multi-LLM)
# ==========================================================
# Proveedores soportados: gemini, openai, anthropic, deepseek, groq, openrouter, ollama, custom
# Si se deja vacío, el sistema detecta automáticamente según las API keys configuradas (default: gemini).
LLM_PROVIDER=openrouter
LLM_MODEL=anthropic/claude-sonnet-4.5

# 1. Google Gemini (https://aistudio.google.com/)
GEMINI_API_KEY=tu_gemini_api_key_aqui
GEMINI_MODEL=gemini-3.7-flash

# 2. OpenAI (https://platform.openai.com/)
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1

# 3. Anthropic Claude (https://console.anthropic.com/)
ANTHROPIC_API_KEY=sk-ant-...

# 4. DeepSeek (https://platform.deepseek.com/)
DEEPSEEK_API_KEY=sk-...

# 5. Groq (https://console.groq.com/)
GROQ_API_KEY=gsk_...

# 6. OpenRouter (https://openrouter.ai/)  <-- proveedor por defecto
# Un único endpoint para cientos de modelos, con mejor disponibilidad que ir
# directo contra un proveedor: si un modelo se satura, la cascada usa el siguiente.
OPENROUTER_API_KEY=sk-or-...
# Cascada de respaldo, separada por comas. Todos deben soportar visión, porque
# el mismo cliente audita los carruseles.
# OPENROUTER_FALLBACKS=anthropic/claude-sonnet-4.5,openai/gpt-5,google/gemini-3.7-flash
# Cabeceras de atribución con las que OpenRouter identifica el tráfico. Por defecto
# apuntan al repositorio que ejecuta el bot; sobrescribilas si querés otra referencia.
# OPENROUTER_REFERER=https://github.com/tu_usuario/autolinkedinpost
# OPENROUTER_TITLE=AutoLinkedInPost

# 7. Ollama (Modelos Locales como LLaMA 3.2, Mistral, Qwen)
OLLAMA_BASE_URL=http://localhost:11434/v1

# 8. Custom OpenAI-Compatible Endpoint (vLLM, LMStudio, LocalAI)
CUSTOM_LLM_BASE_URL=http://localhost:8000/v1
CUSTOM_LLM_API_KEY=tu_api_key_opcional

# ----------------------------------------------------------
# Ajustes de las llamadas al LLM (opcionales, con default)
# ----------------------------------------------------------
# Presupuesto de tokens de salida. El paquete completo (post + primer comentario +
# guion de 10 láminas + sugerencia visual) no entra en 4096.
# LLM_MAX_OUTPUT_TOKENS=8192
# Timeout por request, en segundos. Las respuestas largas necesitan margen.
# LLM_TIMEOUT_SECONDS=90
# Modelo específico para la auditoría visual del carrusel. Si se omite, usa LLM_MODEL.
# LLM_VISION_MODEL=anthropic/claude-sonnet-4.5

# ==========================================================
# TELEGRAM BOT & NOTIFICACIONES
# ==========================================================
# Crear bot en @BotFather
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ
# Obtener tu ID con @userinfobot.
# Sin este valor, el bot interactivo acepta comandos de CUALQUIER chat.
TELEGRAM_CHAT_ID=123456789

# ==========================================================
# GITHUB INTEGRATION & TESTING
# ==========================================================
GH_USERNAME=tu_usuario_de_github
# Opcional para repos públicos, requerido (PAT) para repositorios privados
GH_TOKEN=ghp_tu_personal_access_token_aqui

# Nombre con el que se firman los posts de portafolio. Si se omite, se usa GH_USERNAME.
# GH_AUTHOR_NAME=Tu Nombre

# Emails adicionales con los que commiteás, separados por coma.
# GitHub sólo vincula un commit a tu cuenta cuando el email del autor está verificado
# en tu perfil. Si commiteás desde una máquina con otro correo, esos commits no se
# reconocen como propios y quedan fuera del post. Agregalos acá para que cuenten.
# GH_AUTHOR_EMAILS=otro@correo.com,trabajo@empresa.com

# Repositorio slug (ej: tu_usuario/autolinkedinpost). En GitHub Actions se inyecta
# automáticamente como GITHUB_REPOSITORY. En local o en tests se puede definir explícitamente.
# GITHUB_REPOSITORY=tu_usuario/autolinkedinpost

# Variables para tests automatizados (Open-Source compliance):
# Permiten correr la suite de pruebas desacoplada de repositorios o autores personales harcodeados.
# TEST_REPO_NAME=tu_usuario/tu_repo_de_prueba
# GITHUB_ACTOR=tu_usuario

# ==========================================================
# CONFIGURACIÓN GENERAL
# ==========================================================
LOOKBACK_DAYS=1
PYTHONIOENCODING=utf-8

# Ventana dinámica de commits: fecha ISO-8601 exacta desde la que buscar actividad.
# Sobrescribe LOOKBACK_DAYS si está presente (utilizado en GitHub Actions para corridas continuas).
# SINCE_DATE=2026-08-30T21:00:06Z

# Puerto del healthcheck HTTP del bot interactivo. Render lo define automáticamente;
# en local se puede omitir y el servidor de healthcheck no arranca.
# PORT=10000

# ==========================================================
# GENERACIÓN DE CARRUSELES NATIVOS (HTML/CSS + Playwright)
# ==========================================================
# Genera carruseles PDF de 10 páginas (1080x1350 px, 4:5 vertical) rotando entre los
# temas del catálogo Refero (Linear, Supabase, Raycast, Apple, Cyber Navy, Wispr, Notion).
# El tema se elige de forma determinista según la fecha y el repositorio.
# Requiere: playwright install chromium

# Tema específico para los carruseles (opcional): editorial, terminal, swiss, blueprint, monograph, linear.
# Si se omite, el sistema rota automáticamente entre los estilos del catálogo.
# CAROUSEL_THEME=linear

# Versiones fijas de las librerías que el render carga desde CDN. Están pineadas a
# propósito: con '@latest', un release del paquete puede cambiar el resultado de una
# corrida desatendida sin que nadie toque el repositorio.
# LUCIDE_VERSION=1.35.0
# PAPER_SHADERS_VERSION=0.0.80

# ==========================================================
# LINKEDIN 2026 ENGINE & AUTOMATED PUBLISHING (TIER 1 / TIER 2)
# ==========================================================
# Todas estas variables son OPCIONALES. Sin ninguna variable configurada,
# el motor opera en TIER 0 (Modo Borrador asistido listo para copiar y pegar).
#
# 1. Publora REST API (Tier 1 Recomendado — Publicación y Borradores Persistidos)
# Permite pre-crear borradores de posts y carruseles PDF para aprobarlos de forma
# desacoplada e interactiva desde Telegram.
# Plan gratuito: 15 publicaciones/mes en LinkedIn
# Registro: https://app.publora.com/signup
PUBLORA_API_KEY=sk_tu_api_key_aqui
# ID del canal de conexión en Publora (Channels -> tu cuenta de LinkedIn)
LINKEDIN_PLATFORM_ID=linkedin-tu_id_aqui

# 2. Apify Token (Opcional para skills de analítica y monitoreo de hilos)
# Permite a los skills de la suite (linkedin-thread-monitor, linkedin-engager-analytics)
# consultar hilos y métricas de LinkedIn sin requerir cookies ni contraseñas.
# Registro: https://console.apify.com/sign-up ($5/mes de crédito gratuito)
APIFY_TOKEN=apify_api_tu_token_aqui

# 3. Pixfaro Token (Opcional — backend alternativo e ilustraciones de marca)
# Registro: https://pixfaro.com (formato: pf_live_...)
PIXFARO_TOKEN=pf_live_tu_token_aqui
PIXFARO_ACCOUNT_ID=tu_account_id_opcional

# 4. Custom Poster CLI (Tier 2 Avanzado — delegar publicación a un script propio)
# LINKEDIN_SKILLS_CUSTOM_POSTER=python /ruta/a/tu_poster.py

